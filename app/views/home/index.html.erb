<% content_for :title, "Anisonar | アニメの主題歌を、ジャケットから" %>
<% content_for :full_bleed, true %>

<div class="mx-auto flex min-h-[calc(100vh-3.5rem)] max-w-6xl flex-col py-10 sm:py-14">
  <h1 class="mb-5 px-6 text-center text-sm tracking-[0.3em] text-base-content/50">アニメの主題歌</h1>

  <%# 年を切り替えると棚（この frame）だけを入れ替え、URL も /?year=... に変える。作品ページなど他のリンクはページごと移る %>
  <turbo-frame id="shelf" target="_top" class="block">
  <% if @years.any? %>
    <nav aria-label="放送年" class="mb-4 sm:mb-6">
      <div class="relative overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
           x-data x-init="const chip = $el.querySelector('[aria-current]'); if (chip) $el.scrollLeft = chip.offsetLeft - ($el.clientWidth - chip.offsetWidth) / 2">
        <ul class="mx-auto flex w-max gap-1 px-6">
          <% @years.each do |year| %>
            <li>
              <%= link_to year, root_path(year: year), data: { turbo_frame: "shelf", turbo_action: "advance" },
                    class: "btn btn-xs rounded-full px-3 font-normal tabular-nums #{year == @year ? 'btn-neutral' : 'btn-ghost text-base-content/45'}",
                    aria: { current: (year == @year ? "true" : nil) } %>
            </li>
          <% end %>
        </ul>
      </div>
    </nav>
  <% end %>

  <% if @songs.empty? %>
    <p class="py-20 text-center text-sm text-base-content/50">まだ並べられる曲がありません</p>
  <% else %>
    <% first = @songs.first %>
    <section x-data="recordShelf" data-next-url="<%= shelf_songs_path(year: @year, page: @pagy.next) if @pagy.next %>"
             @keydown.window="onKeydown($event)" aria-label="OP・ED の棚">
      <div class="relative">
        <ul x-ref="track" @scroll.passive="onScroll" @wheel="onWheel($event)"
            @touchstart.passive="cancelTarget()" @scrollend="cancelTarget(); updateActive()"
            class="relative flex snap-x snap-mandatory items-center gap-2 overflow-x-auto py-6 [scrollbar-width:none] sm:gap-4 [&::-webkit-scrollbar]:hidden [mask-image:linear-gradient(to_right,transparent,black_6%,black_94%,transparent)] sm:[mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
          <%# 端の曲も中央に寄せられるようにする余白。高さが 0 だと Firefox / Safari はスクロールできる幅に数えないので self-stretch で高さを持たせる %>
          <li class="w-[calc(19vw-0.5rem)] shrink-0 self-stretch sm:w-[calc(50%-180px-1rem)] lg:w-[calc(50%-200px-1rem)]" aria-hidden="true"></li>
          <%= render partial: "shelf_songs/item", collection: @songs, as: :song %>
          <li x-ref="end" class="w-[calc(19vw-0.5rem)] shrink-0 self-stretch sm:w-[calc(50%-180px-1rem)] lg:w-[calc(50%-200px-1rem)]" aria-hidden="true"></li>
        </ul>

        <button type="button" @click="prev()" :disabled="(target ?? active) === 0"
                class="btn btn-circle btn-ghost btn-sm absolute left-2 top-1/2 hidden -translate-y-1/2 text-base-content/50 disabled:invisible sm:inline-flex"
                aria-label="前の曲">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" @click="next()" :disabled="atEnd()"
                class="btn btn-circle btn-ghost btn-sm absolute right-2 top-1/2 hidden -translate-y-1/2 text-base-content/50 sm:inline-flex"
                aria-label="次の曲">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>

      <%# 中央の曲の情報。最初の曲はサーバー側で描画し、以降は record_shelf.js が書き換える %>
      <div class="mx-auto mt-4 max-w-md px-6 text-center" aria-live="polite">
        <span class="badge badge-sm badge-soft" :class="current.typeClass" x-text="current.typeLabel"><%= song_type_label(first.shelf_song_type) %></span>
        <h2 class="mt-3 truncate text-xl font-semibold tracking-tight sm:text-2xl" x-text="current.title"><%= first.title %></h2>
        <p class="mt-1 truncate text-sm text-base-content/60" x-text="current.artist"><%= first.artist.name %></p>
        <a href="<%= first.shelf_anime_id ? anime_path(first.shelf_anime_id) : anime_series_path(first.shelf_anime_series_id) %>"
           :href="current.workUrl" x-text="current.work"
           class="mt-1 block truncate text-xs text-base-content/40 hover:text-base-content/70 hover:underline"><%= first.shelf_work_title %></a>
      </div>

      <%# Spotify の埋め込みプレーヤーは 1 つだけ置き、中央の曲が変わったら少し待ってから差し替える（record_shelf.js / spotify_player.js） %>
      <div class="mx-auto mt-5 max-w-md px-6">
        <div x-ref="playerSlot" data-track-id="<%= first.spotify_link.platform_track_id %>"
             class="h-20 overflow-hidden rounded-xl bg-base-300/40">
          <noscript>
            <iframe src="https://open.spotify.com/embed/track/<%= first.spotify_link.platform_track_id %>?theme=0"
                    title="Spotify プレーヤー" width="100%" height="80" loading="lazy"
                    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                    class="block w-full border-0"></iframe>
          </noscript>
        </div>
        <a href="<%= first.spotify_url %>" :href="current.spotifyUrl" target="_blank" rel="noopener"
           class="mt-3 inline-flex w-full items-center justify-center gap-1.5 text-xs text-base-content/45 hover:text-base-content/80">
          <%= render "home/spotify_icon", css_class: "h-3.5 w-3.5" %>
          Spotify で開く
        </a>
      </div>
    </section>
  <% end %>
  </turbo-frame>

  <p class="mt-auto flex items-center justify-center gap-1.5 px-6 pt-12 text-[11px] text-base-content/30">
    <%= render "home/spotify_icon", css_class: "h-3 w-3" %>
    ジャケット画像と楽曲へのリンクは Spotify のものです
  </p>
</div>

<%# ジャケットを押すと Spotify の曲を開く。作品名は作品ページへのリンク（a の入れ子を避けて分けている） %>
<% work_path = song.shelf_anime_id ? anime_path(song.shelf_anime_id) : anime_series_path(song.shelf_anime_series_id) %>
<article class="group min-w-0">
  <a href="<%= song.spotify_url %>" target="_blank" rel="noopener"
     class="relative block aspect-square overflow-hidden rounded-md bg-base-300 shadow-md shadow-black/30 ring-1 ring-white/5 transition duration-200 ease-out group-hover:-translate-y-1 group-hover:shadow-xl group-hover:shadow-black/50 focus-visible:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
     aria-label="「<%= song.title %>」を Spotify で聴く（新しいタブで開きます）">
    <% if song.album_image_url.present? %>
      <img src="<%= song.album_image_url %>" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover">
    <% else %>
      <% hue = (song.id * 47) % 360 %>
      <div class="flex h-full w-full items-center justify-center"
           style="background: linear-gradient(135deg, hsl(<%= hue %> 35% 28%), hsl(<%= (hue + 50) % 360 %> 35% 14%));">
        <svg viewBox="0 0 100 100" class="h-3/5 w-3/5 drop-shadow-lg" aria-hidden="true">
          <circle cx="50" cy="50" r="48" fill="#111"/>
          <circle cx="50" cy="50" r="40" fill="none" stroke="#2a2a2a" stroke-width="1"/>
          <circle cx="50" cy="50" r="33" fill="none" stroke="#2a2a2a" stroke-width="1"/>
          <circle cx="50" cy="50" r="26" fill="none" stroke="#2a2a2a" stroke-width="1"/>
          <circle cx="50" cy="50" r="16" fill="hsl(<%= hue %> 70% 62%)"/>
          <circle cx="50" cy="50" r="2.5" fill="#111"/>
        </svg>
      </div>
    <% end %>

    <span class="badge badge-xs <%= song_type_badge_class(song.shelf_song_type) %> absolute left-1.5 top-1.5 font-bold shadow">
      <%= song_type_label(song.shelf_song_type) %>
    </span>

    <%# Spotify のコンテンツであることを示す。ホバーできない端末でもアイコンは常に見える %>
    <span class="absolute bottom-1.5 right-1.5 flex h-6 w-6 items-center justify-center rounded-full bg-black/60 text-[#1ed760] transition-opacity duration-200 group-hover:opacity-0">
      <%= render "home/spotify_icon", css_class: "h-4 w-4" %>
    </span>
    <span class="absolute inset-x-0 bottom-0 flex items-center gap-1.5 bg-linear-to-t from-black/85 to-transparent px-2 pb-2 pt-6 text-[11px] font-semibold text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100">
      <%= render "home/spotify_icon", css_class: "h-4 w-4 text-[#1ed760] shrink-0" %>
      Spotify で聴く
    </span>
  </a>

  <div class="mt-2 px-0.5">
    <p class="truncate text-sm font-semibold leading-snug" title="<%= song.title %>"><%= song.title %></p>
    <p class="truncate text-xs text-base-content/60" title="<%= song.artist.name %>"><%= song.artist.name %></p>
    <%= link_to song.shelf_work_title, work_path,
          class: "block truncate text-xs text-base-content/40 hover:text-primary hover:underline",
          title: song.shelf_work_title %>
  </div>
</article>

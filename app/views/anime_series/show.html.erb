<% content_for :title, "#{@series.name} | Anisonar" %>

<div class="mb-4">
  <%= link_to "← 一覧に戻る", animes_path, class: "btn btn-ghost btn-sm" %>
</div>

<h1 class="text-3xl font-bold mb-8"><%= @series.name %></h1>

<div class="flex flex-col gap-6">
  <% @animes.each do |anime| %>
    <% songs = @anime_songs_by_anime[anime.id] %>
    <div class="flex gap-4 items-start">
      <%# 左: アニメカード %>
      <%= link_to anime_path(anime), class: "shrink-0 w-28 card bg-base-100 shadow hover:shadow-md transition-shadow" do %>
        <figure class="aspect-3/4 bg-base-300">
          <% if anime.cover_image_url.present? %>
            <img src="<%= anime.cover_image_url %>" alt="<%= anime.title %>" class="w-full h-full object-cover">
          <% else %>
            <div class="w-full h-full flex items-center justify-center text-3xl">🎌</div>
          <% end %>
        </figure>
        <div class="card-body p-2">
          <p class="text-xs font-semibold line-clamp-2"><%= anime.title %></p>
          <% if anime.season.present? %>
            <p class="text-xs text-base-content/60"><%= season_label(anime.season) %></p>
          <% end %>
        </div>
      <% end %>

      <%# 右: 楽曲リスト %>
      <div class="flex-1 min-w-0">
        <% if songs.present? %>
          <div class="flex flex-col gap-2">
            <% songs.each do |as| %>
              <%= render "animes/song_row", anime_song: as, song: as.song %>
            <% end %>
          </div>
        <% else %>
          <div class="flex items-center h-full text-sm text-base-content/40 pt-4">楽曲情報なし</div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @series_songs.any? %>
    <div class="flex gap-4 items-start">
      <div class="shrink-0 w-28 flex items-center justify-center pt-2">
        <p class="text-sm font-bold text-base-content/60">シリーズ共通</p>
      </div>
      <div class="flex-1 min-w-0 flex flex-col gap-2">
        <% @series_songs.each do |ss| %>
          <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 flex-row items-center gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="badge badge-secondary badge-sm"><%= ss.song_type.upcase %></span>
                  <span class="font-semibold truncate"><%= ss.song.title %></span>
                </div>
                <p class="text-sm text-base-content/60"><%= ss.song.artist.name %></p>
              </div>
              <% if (link = ss.song.spotify_link) %>
                <a href="https://open.spotify.com/track/<%= link.platform_track_id %>" target="_blank" rel="noopener" class="btn btn-sm btn-success gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                  </svg>
                  Spotify
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

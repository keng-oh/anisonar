<% content_for :title, params[:q].present? || params[:season].present? ? "検索結果 | Anisonar" : "アニメを探す | Anisonar" %>

<div class="hero bg-linear-to-br from-primary/20 to-secondary/20 rounded-2xl mb-10 py-12 px-4">
  <div class="hero-content text-center w-full">
    <div class="w-full max-w-2xl">
      <h1 class="text-3xl font-bold mb-1">🎵 Anisonar</h1>
      <p class="text-base-content/60 mb-6">あのアニソンに出会える場所</p>

      <%= form_with url: animes_path, method: :get, class: "flex flex-wrap gap-2 justify-center" do |f| %>
        <label class="input input-bordered input-lg flex items-center gap-2 flex-1 min-w-64 max-w-md bg-base-100">
          <svg class="h-5 w-5 opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
          <%= f.text_field :q, value: params[:q], placeholder: "アニメタイトルで検索", class: "grow" %>
        </label>

        <%= f.select :season,
          options_for_select([ [ "全シーズン", "" ] ] + @seasons.map { |s| [ season_label(s), s ] }, params[:season]),
          {}, class: "select select-bordered select-lg bg-base-100" %>

        <%= f.submit "検索", class: "btn btn-primary btn-lg" %>
        <%= link_to "クリア", animes_path, class: "btn btn-ghost btn-lg" %>
      <% end %>
    </div>
  </div>
</div>

<% if @search_results.empty? %>
  <div class="hero py-20">
    <div class="hero-content text-center">
      <div>
        <p class="text-5xl mb-4">🔍</p>
        <p class="text-lg text-base-content/60">アニメが見つかりませんでした</p>
      </div>
    </div>
  </div>
<% else %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
    <% @search_results.each do |anime| %>
      <%= render "anime_card", anime: anime %>
    <% end %>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>


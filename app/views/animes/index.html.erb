<% content_for :title, "アニメ一覧 | Anisonar" %>

<div class="mb-6">
  <h1 class="text-3xl font-bold mb-4">アニメ一覧</h1>

  <%= form_with url: animes_path, method: :get, class: "flex flex-wrap gap-2" do |f| %>
    <label class="input input-bordered flex items-center gap-2 flex-1 min-w-48">
      <svg class="h-4 w-4 opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <%= f.text_field :q, value: params[:q], placeholder: "タイトルで検索", class: "grow" %>
    </label>

    <%= f.select :season,
      options_for_select([["全シーズン", ""]] + @seasons.map { |s| [s, s] }, params[:season]),
      {}, class: "select select-bordered" %>

    <%= f.submit "検索", class: "btn btn-primary" %>
    <%= link_to "クリア", animes_path, class: "btn btn-ghost" %>
  <% end %>
</div>

<% if @animes.any? %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-6">
    <% @animes.each do |anime| %>
      <%= link_to anime_path(anime), class: "card bg-base-100 shadow hover:shadow-md transition-shadow cursor-pointer" do %>
        <figure class="aspect-[3/4] bg-base-300">
          <% if anime.cover_image_url.present? %>
            <img src="<%= anime.cover_image_url %>" alt="<%= anime.title %>" class="w-full h-full object-cover">
          <% else %>
            <div class="w-full h-full flex items-center justify-center text-4xl">🎌</div>
          <% end %>
        </figure>
        <div class="card-body p-2">
          <p class="text-sm font-semibold line-clamp-2"><%= anime.title %></p>
          <% if anime.season.present? %>
            <p class="text-xs text-base-content/60"><%= anime.season %></p>
          <% end %>
          <div class="flex gap-1 flex-wrap">
            <span class="badge badge-ghost badge-xs"><%= anime.media_type %></span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>


<% else %>
  <div class="hero py-20">
    <div class="hero-content text-center">
      <div>
        <p class="text-5xl mb-4">🔍</p>
        <p class="text-lg text-base-content/60">アニメが見つかりませんでした</p>
      </div>
    </div>
  </div>
<% end %>

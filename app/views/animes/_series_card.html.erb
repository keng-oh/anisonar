<% cover = animes.min_by { |a| [a.series_order || 999, a.season.to_s] }&.cover_image_url %>
<%= link_to anime_series_path(series), class: "card bg-base-100 shadow hover:shadow-md transition-shadow cursor-pointer" do %>
  <figure class="aspect-[3/4] bg-base-300">
    <% if cover.present? %>
      <img src="<%= cover %>" alt="<%= series.name %>" class="w-full h-full object-cover">
    <% else %>
      <div class="w-full h-full flex items-center justify-center text-4xl">🎌</div>
    <% end %>
  </figure>
  <div class="card-body p-2">
    <p class="text-sm font-semibold line-clamp-2"><%= series.name %></p>
    <p class="text-xs text-base-content/60"><%= animes.size %>作品</p>
  </div>
<% end %>

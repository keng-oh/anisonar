<% content_for :title, "#{@anime.title} | Anisonar" %>

<div class="mb-4">
  <% if @anime.anime_series.present? %>
    <%= link_to "← #{@anime.anime_series.name}", anime_series_path(@anime.anime_series), class: "btn btn-ghost btn-sm" %>
  <% else %>
    <%= link_to "← 一覧に戻る", animes_path, class: "btn btn-ghost btn-sm" %>
  <% end %>
</div>

<div class="flex flex-col md:flex-row gap-6 mb-8">
  <div class="w-full md:w-48 shrink-0">
    <% if @anime.cover_image_url.present? %>
      <img src="<%= @anime.cover_image_url %>" alt="<%= @anime.title %>" class="w-full rounded-xl shadow">
    <% else %>
      <div class="w-full aspect-[3/4] bg-base-300 rounded-xl flex items-center justify-center text-6xl">🎌</div>
    <% end %>
  </div>

  <div class="flex-1">
    <% if @anime.anime_series.present? %>
      <p class="text-sm text-base-content/60 mb-1"><%= @anime.anime_series.name %></p>
    <% end %>
    <h1 class="text-3xl font-bold mb-1"><%= @anime.title %></h1>
    <% if @anime.title_en.present? %>
      <p class="text-base-content/60 mb-3"><%= @anime.title_en %></p>
    <% end %>
    <div class="flex flex-wrap gap-2">
      <span class="badge badge-outline"><%= @anime.media_type.upcase %></span>
      <% if @anime.season.present? %>
        <span class="badge badge-outline"><%= season_label(@anime.season) %></span>
      <% end %>
      <span class="badge <%= @anime.airing? ? 'badge-success' : 'badge-ghost' %>">
        <%= @anime.airing? ? "放送中" : "放送終了" %>
      </span>
    </div>
  </div>
</div>

<h2 class="text-xl font-bold mb-4">楽曲一覧</h2>

<% if @anime_songs.any? %>
  <div class="flex flex-col gap-3">
    <% @anime_songs.each do |as| %>
      <%= render "song_row", anime_song: as, song: as.song %>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-12 text-base-content/60">
    <p class="text-4xl mb-3">🎵</p>
    <p>楽曲情報はまだ登録されていません</p>
  </div>
<% end %>

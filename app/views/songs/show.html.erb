<% content_for :title, "#{@song.title} | Anisonar" %>

<div class="mb-4">
  <% if @song.animes.any? %>
    <%= link_to "← #{@song.animes.first.title}", anime_path(@song.animes.first), class: "btn btn-ghost btn-sm" %>
  <% else %>
    <%= link_to "← 一覧", animes_path, class: "btn btn-ghost btn-sm" %>
  <% end %>
</div>

<div class="card bg-base-100 shadow max-w-2xl mx-auto">
  <div class="card-body gap-4">
    <div>
      <span class="badge badge-primary mb-2"><%= @song.song_type.upcase %></span>
      <h1 class="text-2xl font-bold"><%= @song.title %></h1>
      <p class="text-base-content/70 mt-1"><%= @song.artist.name %></p>
    </div>

    <% if @song.animes.any? %>
      <div>
        <p class="text-sm font-semibold text-base-content/60 mb-1">使用アニメ</p>
        <div class="flex flex-wrap gap-2">
          <% @song.animes.each do |anime| %>
            <%= link_to anime.title, anime_path(anime), class: "badge badge-outline hover:badge-primary" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="divider"></div>

    <% if @spotify_link %>
      <div class="flex flex-col items-center gap-3">
        <p class="text-sm text-base-content/60">Spotifyで聴く</p>
        <a href="https://open.spotify.com/track/<%= @spotify_link.platform_track_id %>"
           target="_blank" rel="noopener"
           class="btn btn-success btn-lg gap-2 w-full max-w-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
          Spotifyで聴く
        </a>
      </div>
    <% else %>
      <div class="text-center py-4 text-base-content/40">
        <p>Spotifyリンクは未登録です</p>
      </div>
    <% end %>

    <% if @song.notes.present? %>
      <div class="divider"></div>
      <div>
        <p class="text-sm font-semibold text-base-content/60 mb-1">メモ</p>
        <p class="text-sm"><%= @song.notes %></p>
      </div>
    <% end %>
  </div>
</div>

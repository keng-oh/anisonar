<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "管理画面 | Anisonar" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-base-200" data-theme="night">
    <nav class="navbar bg-neutral text-neutral-content px-4">
      <div class="navbar-start">
        <%= link_to "🛠 管理画面", admin_root_path, class: "text-lg font-bold" %>
      </div>
      <div class="navbar-center gap-4 hidden md:flex">
        <%= link_to "アニメ", admin_animes_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "楽曲レビュー", admin_songs_path, class: "btn btn-ghost btn-sm" %>
        <%= link_to "Sidekiq", "/sidekiq", class: "btn btn-ghost btn-sm", target: "_blank" %>
      </div>
      <div class="navbar-end gap-2">
        <%= link_to "← サイトへ", root_path, class: "btn btn-ghost btn-sm" %>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
      </div>
    </nav>

    <main class="container mx-auto px-4 py-8 max-w-7xl">
      <% if notice %>
        <div role="alert" class="alert alert-success mb-4">
          <span><%= notice %></span>
        </div>
      <% end %>
      <% if alert %>
        <div role="alert" class="alert alert-error mb-4">
          <span><%= alert %></span>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>

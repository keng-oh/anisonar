<!DOCTYPE html>
<html x-data="{ theme: localStorage.getItem('anisonar-theme') || 'night' }" x-init="$watch('theme', v => localStorage.setItem('anisonar-theme', v))" :data-theme="theme">
  <head>
    <title><%= content_for(:title) || "管理画面 | Anisonar" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <style>[x-cloak] { display: none !important; }</style>
  </head>

  <body class="min-h-screen bg-base-200">
    <div class="drawer lg:drawer-open">
      <input id="admin-drawer" type="checkbox" class="drawer-toggle">

      <div class="drawer-content flex flex-col min-h-screen">
        <!-- Navbar -->
        <nav class="navbar bg-base-100 border-b border-base-300 sticky top-0 z-40 px-4 min-h-14 h-14 gap-3">
          <div class="flex-none lg:hidden">
            <label for="admin-drawer" class="btn btn-ghost btn-square btn-sm" aria-label="メニューを開く">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </label>
          </div>

          <div class="flex items-center gap-2 ml-auto">
            <%= link_to crawl_requests_admin_integrations_path, class: "btn btn-primary btn-sm gap-1.5" do %>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
              AI収集実行
            <% end %>

            <!-- Theme toggle -->
            <button type="button" class="btn btn-ghost btn-circle btn-sm" title="テーマ切替"
                    @click="theme = (theme === 'night' ? 'light' : 'night')">
              <template x-if="theme === 'night'">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/>
                  <path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </template>
              <template x-if="theme !== 'night'">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </template>
            </button>
          </div>
        </nav>

        <!-- Page -->
        <main class="flex-1 p-6 overflow-auto">
          <% if notice %>
            <div role="alert" class="alert alert-success mb-4">
              <span><%= notice %></span>
            </div>
          <% end %>
          <% if alert %>
            <div role="alert" class="alert alert-error mb-4">
              <span><%= alert %></span>
            </div>
          <% end %>
          <%= yield %>
        </main>
      </div>

      <!-- Sidebar -->
      <div class="drawer-side z-50">
        <label for="admin-drawer" aria-label="メニューを閉じる" class="drawer-overlay"></label>
        <aside class="bg-base-100 border-r border-base-300 w-56 min-h-full flex flex-col">

          <!-- Logo -->
          <%= link_to admin_root_path, class: "flex items-center gap-3 px-5 py-5 border-b border-base-300" do %>
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 bg-linear-to-br from-primary to-secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M9 18V5l12-2v13" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="6" cy="18" r="3" stroke="white" stroke-width="2"/>
                <circle cx="18" cy="16" r="3" stroke="white" stroke-width="2"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-sm tracking-tight text-base-content">Anisonar</div>
              <div class="text-xs opacity-40">管理パネル</div>
            </div>
          <% end %>

          <!-- Navigation -->
          <ul class="menu menu-sm flex-1 px-3 py-4 gap-0.5">
            <li class="menu-title">メイン</li>
            <li>
              <%= link_to admin_root_path, class: sidebar_link_class(current_page?(admin_root_path)) do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="3" width="7" height="7" rx="1.5" fill="currentColor"/>
                  <rect x="14" y="3" width="7" height="7" rx="1.5" fill="currentColor" opacity="0.4"/>
                  <rect x="3" y="14" width="7" height="7" rx="1.5" fill="currentColor" opacity="0.4"/>
                  <rect x="14" y="14" width="7" height="7" rx="1.5" fill="currentColor" opacity="0.4"/>
                </svg>
                ダッシュボード
              <% end %>
            </li>
            <li>
              <%= link_to admin_animes_path, class: sidebar_link_class(current_page?(admin_animes_path)) do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M4 19.5A2.5 2.5 0 016.5 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" stroke="currentColor" stroke-width="2"/>
                </svg>
                アニメ管理
              <% end %>
            </li>

            <li class="menu-title mt-1">楽曲</li>
            <li>
              <%= link_to all_admin_songs_path, class: sidebar_link_class(current_page?(all_admin_songs_path)) do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="2"/>
                  <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="2"/>
                </svg>
                楽曲一覧
              <% end %>
            </li>
            <li>
              <%= link_to admin_songs_path, class: sidebar_link_class(current_page?(admin_songs_path)) do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M9 11l3 3L22 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                レビューキュー
                <% if @pending_review_count.to_i > 0 %>
                  <span class="badge badge-primary badge-sm ml-auto"><%= @pending_review_count %></span>
                <% end %>
              <% end %>
            </li>
            <li>
              <%= link_to new_admin_song_path, class: sidebar_link_class(current_page?(new_admin_song_path)) do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                楽曲追加
              <% end %>
            </li>

            <li class="menu-title mt-1">外部連携</li>
            <li>
              <%= link_to cover_images_admin_integrations_path, class: sidebar_link_class(current_page?(cover_images_admin_integrations_path)) do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="2"/>
                  <path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                画像一括取得
              <% end %>
            </li>
            <li>
              <%= link_to spotify_admin_integrations_path, class: sidebar_link_class(current_page?(spotify_admin_integrations_path)) do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                </svg>
                Spotify一括解決
              <% end %>
            </li>
            <li>
              <%= link_to crawl_requests_admin_integrations_path, class: sidebar_link_class(current_page?(crawl_requests_admin_integrations_path)) do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
                  <path d="M19.07 4.93l-1.41 1.41M4.93 4.93l1.41 1.41M19.07 19.07l-1.41-1.41M4.93 19.07l1.41-1.41M12 2v2M12 20v2M2 12h2M20 12h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                n8nクロールキュー
              <% end %>
            </li>
            <li>
              <%= link_to annict_sync_admin_integrations_path, class: sidebar_link_class(current_page?(annict_sync_admin_integrations_path)) do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M17 2.1l4 4-4 4M3 14v-1a4 4 0 014-4h14M7 21.9l-4-4 4-4M21 10v1a4 4 0 01-4 4H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Annict同期
              <% end %>
            </li>
          </ul>

          <div class="border-t border-base-300 mx-3 my-1"></div>

          <ul class="menu menu-sm px-3 gap-0.5">
            <li><%= link_to "Sidekiq", "/sidekiq", target: "_blank", class: "gap-2.5" %></li>
            <% if Rails.env.development? %>
              <li><%= link_to "Mailhog", "http://localhost:8025", target: "_blank", class: "gap-2.5" %></li>
            <% end %>
          </ul>

          <!-- User -->
          <div class="p-3 border-t border-base-300">
            <div class="flex items-center gap-3 p-2 rounded-lg">
              <div class="avatar avatar-placeholder">
                <div class="rounded-full w-8 bg-linear-to-br from-primary to-secondary text-white font-bold text-xs">
                  <span><%= current_user.email.first.upcase %></span>
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-xs font-semibold truncate"><%= current_user.email %></div>
                <div class="text-xs opacity-40"><%= current_user.role %></div>
              </div>
            </div>
            <div class="flex flex-col gap-1 mt-1">
              <%= link_to "← サイトへ", root_path, class: "btn btn-ghost btn-sm justify-start" %>
              <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn-ghost btn-sm w-full justify-start" %>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </body>
</html>

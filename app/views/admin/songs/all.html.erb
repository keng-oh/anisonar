<% content_for :title, "楽曲一覧 | 管理画面" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">楽曲一覧</h1>
  <span class="badge badge-outline"><%= @pagy.count %> 件</span>
</div>

<%= form_with url: all_admin_songs_path, method: :get, class: "mb-4 flex flex-wrap gap-2 items-end" do |f| %>
  <label class="input input-bordered flex items-center gap-2 flex-1 min-w-48">
    <%= f.text_field :q, value: params[:q], placeholder: "タイトル・アーティストで検索", class: "grow" %>
  </label>

  <%= f.select :sort,
        [ [ "新しい順", "newest" ], [ "古い順", "oldest" ], [ "タイトル順", "title" ] ],
        { selected: params[:sort] || "newest" },
        class: "select select-bordered" %>

  <%= f.select :platform,
        [ [ "プラットフォーム連携: 全て", "" ], [ "未連携のみ", "unlinked" ] ],
        { selected: params[:platform] },
        class: "select select-bordered" %>

  <%= f.submit "絞り込み", class: "btn btn-primary" %>
  <%= link_to "クリア", all_admin_songs_path, class: "btn btn-ghost" %>
<% end %>

<div class="overflow-x-auto">
  <table class="table table-zebra">
    <thead>
      <tr>
        <th></th>
        <th>タイトル</th>
        <th>アーティスト</th>
        <th>アニメ・種別</th>
        <th>Spotify</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @songs.each do |song| %>
        <% spotify_link = song.platform_links.find(&:spotify?) %>
        <tr>
          <td>
            <% if song.album_image_url.present? %>
              <img src="<%= song.album_image_url %>" class="w-8 h-8 rounded object-cover">
            <% end %>
          </td>
          <td class="font-semibold max-w-48 truncate"><%= song.title %></td>
          <td class="text-sm max-w-32 truncate"><%= song.artist.name %></td>
          <td class="text-sm">
            <% song.anime_songs.each do |as| %>
              <div class="flex items-center gap-1.5 mb-0.5 whitespace-nowrap">
                <span class="badge badge-xs <%= song_type_badge_class(as.song_type) %>"><%= song_type_label(as.song_type) %></span>
                <span class="truncate max-w-48"><%= as.anime.title %></span>
              </div>
            <% end %>
          </td>
          <td class="text-sm whitespace-nowrap">
            <% if spotify_link %>
              <span class="badge badge-success badge-sm">連携済み</span>
            <% else %>
              <span class="badge badge-ghost badge-sm">未連携</span>
            <% end %>
          </td>
          <td>
            <div class="flex gap-1 justify-end">
              <%= link_to "編集", edit_admin_song_path(song), class: "btn btn-ghost btn-xs" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mt-6">
    <div class="join">
      <%= link_to "«", @pagy.previous ? @pagy.page_url(@pagy.previous) : "#",
            class: "join-item btn btn-sm #{'btn-disabled' unless @pagy.previous}" %>
      <% ([1, @pagy.page - 2].max..[@pagy.pages, @pagy.page + 2].min).each do |p| %>
        <%= link_to p, @pagy.page_url(p),
              class: "join-item btn btn-sm #{'btn-active' if p == @pagy.page}" %>
      <% end %>
      <%= link_to "»", @pagy.next ? @pagy.page_url(@pagy.next) : "#",
            class: "join-item btn btn-sm #{'btn-disabled' unless @pagy.next}" %>
    </div>
  </div>
<% end %>

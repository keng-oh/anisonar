<% content_for :title, "楽曲レビューキュー | 管理画面" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">楽曲レビューキュー</h1>
  <div class="flex items-center gap-2">
    <span class="badge badge-warning badge-outline"><%= @songs.count %> 件 pending</span>
    <%= link_to "楽曲を追加", new_admin_song_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>

<% if @songs.any? %>
  <div class="flex flex-col gap-4">
    <% @songs.each do |song| %>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-4">
          <div class="flex flex-col sm:flex-row sm:items-start gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <span class="badge badge-primary badge-sm"><%= song.song_type.upcase %></span>
                <span class="badge <%= song.pending? ? 'badge-warning' : 'badge-info' %> badge-sm">
                  <%= song.status %>
                </span>
                <span class="badge badge-ghost badge-sm"><%= song.registered_by %></span>
              </div>
              <p class="font-semibold text-lg"><%= song.title %></p>
              <p class="text-sm text-base-content/60">アーティスト: <%= song.artist.name %></p>
              <% if song.animes.any? %>
                <p class="text-sm text-base-content/60">
                  アニメ: <%= song.animes.map(&:title).join(", ") %>
                </p>
              <% end %>
              <% if song.notes.present? %>
                <p class="text-sm text-base-content/50 mt-1"><%= song.notes %></p>
              <% end %>
              <p class="text-xs text-base-content/40 mt-1">登録: <%= song.created_at.strftime("%Y-%m-%d") %></p>
            </div>

            <div class="flex gap-2 shrink-0">
              <%= link_to "編集", edit_admin_song_path(song), class: "btn btn-ghost btn-sm" %>
              <%= button_to "承認", approve_admin_song_path(song), method: :patch,
                class: "btn btn-success btn-sm",
                data: { turbo_confirm: "「#{song.title}」を承認しますか？" } %>
              <%= button_to "否認", reject_admin_song_path(song), method: :patch,
                class: "btn btn-error btn-sm",
                data: { turbo_confirm: "「#{song.title}」を否認しますか？" } %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>


<% else %>
  <div class="hero py-20">
    <div class="hero-content text-center">
      <div>
        <p class="text-5xl mb-4">✅</p>
        <p class="text-lg">レビュー待ちの楽曲はありません</p>
      </div>
    </div>
  </div>
<% end %>

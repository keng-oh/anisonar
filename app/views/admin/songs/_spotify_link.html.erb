<div class="card bg-base-100 shadow-sm"
  x-data="{
    loading: false,
    error: null,
    candidates: [],
    manualInput: '',

    search() {
      this.loading = true
      this.error = null
      this.candidates = []
      fetch('<%= spotify_candidates_api_admin_song_path(song) %>', { credentials: 'same-origin' })
        .then(r => r.json())
        .then(data => {
          if (data.error) { this.error = data.error } else { this.candidates = data }
          this.loading = false
        })
    },

    fetchById() {
      const match = this.manualInput.trim().match(/track[/:]([a-zA-Z0-9]+)/)
      const id = match ? match[1] : this.manualInput.trim()
      if (!id) return

      this.loading = true
      this.error = null
      this.candidates = []
      fetch(`<%= spotify_track_api_admin_song_path(song) %>?track_id=${encodeURIComponent(id)}`, { credentials: 'same-origin' })
        .then(r => r.json())
        .then(data => {
          if (data.error) { this.error = data.error } else { this.candidates = [data] }
          this.loading = false
        })
    },

    select(candidate) {
      const form = document.getElementById('spotify-link-form-<%= song.id %>')
      form.querySelector('[name=platform_track_id]').value   = candidate.id
      form.querySelector('[name=album_platform_id]').value   = candidate.album_platform_id || ''
      form.querySelector('[name=album_name]').value           = candidate.album_name || ''
      form.querySelector('[name=album_image_url]').value      = candidate.album_image_url || ''
      form.querySelector('[name=album_release_date]').value   = candidate.album_release_date || ''
      form.querySelector('[name=artist_spotify_id]').value    = candidate.artist_spotify_id || ''
      form.requestSubmit()
    }
  }">
  <div class="card-body gap-3">
    <h2 class="card-title text-lg">Spotify連携</h2>

    <% if song.spotify_link %>
      <div class="flex items-center gap-3">
        <% if song.spotify_link.album_image_url.present? %>
          <img src="<%= song.spotify_link.album_image_url %>" class="w-12 h-12 rounded object-cover">
        <% end %>
        <div class="text-sm">
          <p class="text-base-content/60"><%= song.spotify_link.album_name %></p>
          <%= link_to song.spotify_link.platform_track_id, "https://open.spotify.com/track/#{song.spotify_link.platform_track_id}",
                target: "_blank", rel: "noopener", class: "link link-primary text-xs" %>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-base-content/50">未連携</p>
    <% end %>

    <button type="button" class="btn btn-sm btn-outline w-fit" @click="search()" :disabled="loading">
      <span x-show="!loading">Spotifyで検索</span>
      <span x-show="loading">検索中...</span>
    </button>

    <div class="flex items-center gap-2">
      <input type="text" class="input input-bordered input-sm flex-1"
        placeholder="見つからない場合: SpotifyのURLまたはトラックIDを貼り付け"
        x-model="manualInput"
        @keydown.enter.prevent="fetchById()">
      <button type="button" class="btn btn-sm btn-outline" @click="fetchById()" :disabled="loading || !manualInput.trim()">取得</button>
    </div>

    <p x-show="error" class="text-sm text-error" x-text="error"></p>

    <div x-show="candidates.length > 0" class="flex flex-col gap-2">
      <template x-for="candidate in candidates" :key="candidate.id">
        <div class="flex items-center gap-3 p-2 border border-base-300 rounded-lg">
          <img :src="candidate.album_image_url" x-show="candidate.album_image_url" class="w-10 h-10 rounded object-cover">
          <div class="text-sm flex-1 min-w-0">
            <a :href="candidate.url" target="_blank" rel="noopener" class="link link-primary font-semibold truncate block" x-text="candidate.name"></a>
            <p class="text-base-content/60 truncate" x-text="candidate.artists + ' / ' + candidate.album_name"></p>
          </div>
          <button type="button" class="btn btn-xs btn-primary" @click="select(candidate)">選択</button>
        </div>
      </template>
    </div>

    <%= form_with url: spotify_link_admin_song_path(song), method: :post, html: { id: "spotify-link-form-#{song.id}", class: "hidden" } do |sf| %>
      <%= sf.hidden_field :platform_track_id %>
      <%= sf.hidden_field :album_platform_id %>
      <%= sf.hidden_field :album_name %>
      <%= sf.hidden_field :album_image_url %>
      <%= sf.hidden_field :album_release_date %>
      <%= hidden_field_tag :artist_spotify_id %>
    <% end %>
  </div>
</div>

<%= form_with model: [:admin, song], class: "flex flex-col gap-4" do |f| %>
  <% if song.errors.any? %>
    <div role="alert" class="alert alert-error">
      <ul class="list-disc list-inside text-sm">
        <% song.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body gap-4">
      <h2 class="card-title text-lg">基本情報</h2>

      <div class="form-control">
        <label class="label"><span class="label-text">タイトル <span class="text-error">*</span></span></label>
        <%= f.text_field :title, class: "input input-bordered w-full", placeholder: "楽曲タイトル" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="form-control">
          <label class="label"><span class="label-text">種別 <span class="text-error">*</span></span></label>
          <%= f.select :song_type,
            Song.song_types.keys.map { |k| [k.upcase, k] },
            {},
            class: "select select-bordered w-full" %>
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text">ステータス</span></label>
          <%= f.select :status,
            Song.statuses.keys.map { |k| [k, k] },
            {},
            class: "select select-bordered w-full" %>
        </div>
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">メモ</span></label>
        <%= f.text_area :notes, class: "textarea textarea-bordered w-full", rows: 2, placeholder: "管理用メモ（任意）" %>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body gap-4">
      <h2 class="card-title text-lg">アーティスト</h2>

      <div class="form-control">
        <label class="label"><span class="label-text">アーティスト <span class="text-error">*</span></span></label>
        <%= f.select :artist_id,
          Artist.order(:name).map { |a| ["#{a.name}（#{a.artist_type}）", a.id] },
          { include_blank: "選択してください" },
          class: "select select-bordered w-full" %>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body gap-4">
      <h2 class="card-title text-lg">紐付けアニメ</h2>

      <div class="form-control">
        <label class="label">
          <span class="label-text">アニメ（複数選択可）</span>
        </label>
        <div class="border border-base-300 rounded-lg p-3 max-h-60 overflow-y-auto flex flex-col gap-1">
          <% Anime.order(season: :desc, title: :asc).each do |anime| %>
            <label class="flex items-center gap-2 cursor-pointer py-1">
              <input type="checkbox" name="song[anime_ids][]" value="<%= anime.id %>"
                class="checkbox checkbox-sm checkbox-primary"
                <%= "checked" if song.animes.include?(anime) %>>
              <span class="text-sm">
                <%= anime.title %>
                <% if anime.season.present? %>
                  <span class="text-base-content/50 text-xs">（<%= anime.season %>）</span>
                <% end %>
              </span>
            </label>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-2">
    <%= link_to "キャンセル", admin_songs_path, class: "btn btn-ghost" %>
    <%= f.submit class: "btn btn-primary" %>
  </div>
<% end %>

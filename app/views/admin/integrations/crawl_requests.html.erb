<% content_for :title, "n8nクロールキュー | 管理画面" %>

<h1 class="text-2xl font-bold mb-6">n8nクロールキュー</h1>

<div class="card bg-base-100 shadow-sm">
  <div class="card-body">
    <p class="text-sm text-base-content/60 mb-2">
      アニメ編集画面の「📥 クロールキューへ追加」で追加されたクロール依頼の状況です。
    </p>
    <% if @crawl_requests.any? %>
      <div class="overflow-x-auto">
        <table class="table table-zebra table-sm">
          <thead>
            <tr>
              <th>アニメ</th>
              <th>URL</th>
              <th>ステータス</th>
              <th>Difyドキュメント</th>
              <th>作成日時</th>
            </tr>
          </thead>
          <tbody>
            <% @crawl_requests.each do |cr| %>
              <tr>
                <td><%= cr.anime.title %></td>
                <td class="text-xs max-w-xs truncate"><%= cr.url %></td>
                <td><span class="badge badge-sm"><%= cr.status %></span></td>
                <td class="text-xs"><%= cr.dify_document_id %></td>
                <td class="text-xs"><%= cr.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-base-content/50">クロール依頼はまだありません</p>
    <% end %>
  </div>
</div>

<% content_for :title, "n8nクロールキュー | 管理画面" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">n8nクロールキュー</h1>
  <div class="flex items-center gap-3">
    <span class="badge badge-outline"><%= @pagy.count %> 件</span>
    <%= button_to "視聴者数上位10件を一括追加", bulk_enqueue_crawl_requests_admin_integrations_path(limit: 10),
          method: :post, class: "btn btn-primary btn-sm",
          form: { data: { turbo_confirm: "未追加のアニメから視聴者数上位10件をクロールキューに追加します（シリーズ所属アニメはシリーズ単位でまとめられます）。よろしいですか？" } } %>
  </div>
</div>

<div class="card bg-base-100 shadow-sm">
  <div class="card-body">
    <p class="text-sm text-base-content/60 mb-2">
      アニメ編集画面の「📥 クロールキューへ追加」で追加されたクロール依頼の状況です。
    </p>

    <%= form_with url: crawl_requests_admin_integrations_path, method: :get, class: "mb-4 flex flex-wrap gap-2 items-end" do |f| %>
      <%= f.select :status,
            [ [ "未処理", "pending" ], [ "クロール中", "crawling" ], [ "クロール済み", "crawled" ],
              [ "抽出中", "extracting" ], [ "完了", "done" ], [ "失敗", "failed" ], [ "全て", "all" ] ],
            { selected: @status },
            class: "select select-bordered" %>

      <%= f.submit "絞り込み", class: "btn btn-primary" %>
    <% end %>

    <% if @crawl_requests.any? %>
      <div class="overflow-x-auto">
        <table class="table table-zebra table-sm">
          <thead>
            <tr>
              <th>対象</th>
              <th>ステータス</th>
              <th>Difyドキュメント</th>
              <th>作成日時</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @crawl_requests.each do |cr| %>
              <tr>
                <td>
                  <% if cr.anime %>
                    <%= link_to cr.anime.title, edit_admin_anime_path(cr.anime), class: "link link-hover" %>
                  <% else %>
                    <span class="badge badge-outline badge-sm mr-1">シリーズ</span><%= cr.anime_series.name %>
                  <% end %>
                </td>
                <td><span class="badge badge-sm"><%= cr.status %></span></td>
                <td class="text-xs"><%= cr.dify_document_id %></td>
                <td class="text-xs"><%= cr.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="text-right">
                  <%= button_to "削除", admin_crawl_request_path(cr, status: @status), method: :delete,
                        class: "btn btn-ghost btn-xs text-error",
                        form: { data: { turbo_confirm: "「#{cr.target_label}」のクロール依頼を削除しますか？" } } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="flex justify-center mt-6">
          <div class="join">
            <%= link_to "«", @pagy.previous ? @pagy.page_url(@pagy.previous) : "#",
                  class: "join-item btn btn-sm #{'btn-disabled' unless @pagy.previous}" %>
            <% ([1, @pagy.page - 2].max..[@pagy.pages, @pagy.page + 2].min).each do |p| %>
              <%= link_to p, @pagy.page_url(p),
                    class: "join-item btn btn-sm #{'btn-active' if p == @pagy.page}" %>
            <% end %>
            <%= link_to "»", @pagy.next ? @pagy.page_url(@pagy.next) : "#",
                  class: "join-item btn btn-sm #{'btn-disabled' unless @pagy.next}" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-base-content/50">クロール依頼はまだありません</p>
    <% end %>
  </div>
</div>

<% content_for :title, "Spotify一括解決 | 管理画面" %>

<div class="max-w-xl">
  <h1 class="text-2xl font-bold mb-6">Spotify一括解決</h1>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body">
      <p class="text-sm text-base-content/60 mb-2">承認済みでSpotify未連携の楽曲を検索します。</p>
      <%= button_to "Spotify未連携を一括解決", bulk_spotify_resolve_admin_songs_path, method: :post,
            class: "btn btn-success btn-sm w-fit",
            data: { turbo_confirm: "承認済みでSpotify未連携の楽曲を検索します。よろしいですか？" } %>
    </div>
  </div>
</div>

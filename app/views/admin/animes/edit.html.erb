<% content_for :title, "#{@anime.title} 編集 | 管理画面" %>

<div class="mb-4 flex items-center justify-between">
  <%= link_to "← 一覧に戻る", return_to_list_path(admin_animes_path), class: "btn btn-ghost btn-sm" %>
  <%= button_to enqueue_crawl_request_admin_anime_path(@anime, return_to: params[:return_to].presence),
        method: :post,
        class: "btn btn-outline btn-sm" do %>
    📥 クロールキューへ追加
  <% end %>
</div>

<div class="card bg-base-100 shadow max-w-xl">
  <div class="card-body">
    <h1 class="card-title text-xl mb-4">アニメ編集</h1>

    <%= form_with model: [:admin, @anime], class: "flex flex-col gap-4" do |f| %>
      <div class="form-control">
        <%= f.label :title, "タイトル", class: "label" %>
        <%= f.text_field :title, class: "input input-bordered" %>
        <% @anime.errors[:title].each do |msg| %>
          <span class="text-error text-sm"><%= msg %></span>
        <% end %>
      </div>

      <div class="form-control">
        <%= f.label :title_en, "タイトル（英語）", class: "label" %>
        <%= f.text_field :title_en, class: "input input-bordered" %>
      </div>

      <div class="form-control">
        <%= f.label :media_type, "メディア種別", class: "label" %>
        <%= f.select :media_type,
          Anime.media_types.keys.map { |k| [k.upcase, k] },
          {}, class: "select select-bordered" %>
      </div>

      <div class="form-control">
        <%= f.label :season_year, "シーズン", class: "label" %>
        <% current_year = Date.current.year %>
        <% years = (1960..(current_year + 1)).to_a.reverse %>
        <% years << @anime.season_year.to_i if @anime.season_year.present? && !years.include?(@anime.season_year.to_i) %>
        <div class="flex gap-2">
          <%= f.select :season_year, years.map { |y| [ "#{y}年", y ] }, { include_blank: "未設定" }, class: "select select-bordered flex-1" %>
          <%= f.select :season_name, [ [ "季節: 未設定", "" ] ] + Anime::SEASON_NAMES_IN_ORDER.map { |n| [ Anime::SEASON_NAME_LABELS.fetch(n), n ] }, {}, class: "select select-bordered flex-1" %>
        </div>
      </div>

      <div class="form-control">
        <%= f.label :status, "ステータス", class: "label" %>
        <%= f.select :status,
          [["放送中", "airing"], ["放送終了", "finished"]],
          {}, class: "select select-bordered" %>
      </div>

      <div class="form-control">
        <%= f.label :cover_image_url, "カバー画像URL", class: "label" %>
        <%= f.text_field :cover_image_url, class: "input input-bordered" %>
        <% if @anime.cover_image_url.present? %>
          <img src="<%= @anime.cover_image_url %>" class="mt-2 h-32 object-cover rounded" />
        <% end %>
      </div>

      <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>

      <div class="card-actions justify-end mt-2">
        <%= link_to "キャンセル", return_to_list_path(admin_animes_path), class: "btn btn-ghost" %>
        <%= f.submit "保存", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

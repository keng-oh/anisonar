<% content_for :title, "アーティスト編集 | 管理画面" %>

<div class="max-w-2xl">
  <h1 class="text-2xl font-bold mb-6">アーティスト編集: <%= @artist.name %></h1>

  <%= render "form", artist: @artist %>

  <div class="mt-4">
    <%= render "spotify_link", artist: @artist %>
  </div>

  <div class="card bg-base-100 shadow-sm mt-4">
    <div class="card-body gap-3">
      <h2 class="card-title text-lg">登録楽曲（<%= @artist.songs.size %>件）</h2>

      <% if @artist.songs.any? %>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>タイトル</th>
                <th>アニメ・種別</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @artist.songs.includes(anime_songs: :anime).each do |song| %>
                <tr>
                  <td class="font-semibold"><%= song.title %></td>
                  <td class="text-sm">
                    <% song.anime_songs.each do |as| %>
                      <div class="flex items-center gap-1.5 mb-0.5">
                        <span class="badge badge-xs <%= song_type_badge_class(as.song_type) %>"><%= song_type_label(as.song_type) %></span>
                        <span class="truncate"><%= as.anime.title %></span>
                      </div>
                    <% end %>
                  </td>
                  <td class="text-right">
                    <%= link_to "編集", edit_admin_song_path(song), class: "btn btn-ghost btn-xs" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-base-content/50">登録されている楽曲はありません</p>
      <% end %>
    </div>
  </div>

  <div class="mt-6 flex justify-end items-center gap-2">
    <% if @artist.songs.any? %>
      <p class="text-sm text-base-content/50">紐づく楽曲がある間は削除できません</p>
    <% else %>
      <%= button_to "このアーティストを削除", admin_artist_path(@artist), method: :delete,
            class: "btn btn-error btn-outline btn-sm",
            form: { data: { turbo_confirm: "「#{@artist.name}」を削除しますか？この操作は取り消せません" } } %>
    <% end %>
  </div>
</div>

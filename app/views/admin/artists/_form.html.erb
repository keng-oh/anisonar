<%= form_with model: [ :admin, artist ], class: "flex flex-col gap-4" do |f| %>
  <% if artist.errors.any? %>
    <div role="alert" class="alert alert-error">
      <ul class="list-disc list-inside text-sm">
        <% artist.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-sm" x-data="{ artistType: '<%= artist.artist_type %>' }">
    <div class="card-body gap-4">
      <h2 class="card-title text-lg">基本情報</h2>

      <div class="grid grid-cols-2 gap-3">
        <div class="form-control">
          <label class="label"><span class="label-text">名前 <span class="text-error">*</span></span></label>
          <%= f.text_field :name, class: "input input-bordered w-full" %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">読み（カナ）</span></label>
          <%= f.text_field :name_kana, class: "input input-bordered w-full" %>
        </div>
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">種別 <span class="text-error">*</span></span></label>
        <%= f.select :artist_type,
              Artist.artist_types.keys.map { |t| [ t, t ] },
              {},
              class: "select select-bordered w-full", "x-model": "artistType" %>
      </div>

      <div class="form-control" x-show="artistType === 'character'" x-cloak>
        <label class="label"><span class="label-text">所属アニメ（キャラクターの場合必須）</span></label>
        <%= f.collection_select :anime_id,
              Anime.order(season: :desc, title: :asc), :id,
              ->(anime) { "#{anime.title}#{"（#{season_label(anime.season)}）" if anime.season.present?}" },
              { include_blank: "選択してください" },
              class: "select select-bordered w-full" %>
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">画像 URL</span></label>
        <%= f.text_field :image_url, class: "input input-bordered w-full", placeholder: "https://..." %>
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-2">
    <%= link_to "キャンセル", admin_artists_path, class: "btn btn-ghost" %>
    <%= f.submit (artist.persisted? ? "更新" : "登録"), class: "btn btn-primary" %>
  </div>
<% end %>

<%= form_with model: [ :admin, artist ], class: "flex flex-col gap-4" do |f| %>
  <% if artist.errors.any? %>
    <div role="alert" class="alert alert-error">
      <ul class="list-disc list-inside text-sm">
        <% artist.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-sm" x-data="{ artistType: '<%= artist.artist_type %>' }">
    <div class="card-body gap-4">
      <h2 class="card-title text-lg">基本情報</h2>

      <div class="grid grid-cols-2 gap-3">
        <div class="form-control">
          <label class="label"><span class="label-text">名前 <span class="text-error">*</span></span></label>
          <%= f.text_field :name, class: "input input-bordered w-full" %>
        </div>
        <div class="form-control">
          <label class="label"><span class="label-text">読み（カナ）</span></label>
          <%= f.text_field :name_kana, class: "input input-bordered w-full" %>
        </div>
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">種別 <span class="text-error">*</span></span></label>
        <%= f.select :artist_type,
              Artist.artist_types.keys.map { |t| [ artist_type_label(t), t ] },
              {},
              class: "select select-bordered w-full", "x-model": "artistType" %>
      </div>

      <%# 所属アニメ（インクリメンタルサーチ。1件だけ選ぶ） %>
      <div class="form-control relative" x-show="artistType === 'character'" x-cloak
        x-data="{
          query: '',
          results: [],
          selected: <%= (artist.anime ? { id: artist.anime.id, title: artist.anime.title, season: season_label(artist.anime.season) } : nil).to_json %>,
          debounce: null,

          search() {
            clearTimeout(this.debounce)
            if (!this.query) { this.results = []; return }
            this.debounce = setTimeout(() => {
              fetch(`/api/admin/animes?q=${encodeURIComponent(this.query)}`, { credentials: 'same-origin' })
                .then(r => r.json())
                .then(data => { this.results = data })
            }, 300)
          },

          choose(anime) {
            this.selected = anime
            this.query = ''
            this.results = []
          },

          clear() { this.selected = null }
        }">
        <label class="label"><span class="label-text">所属アニメ（キャラクターの場合必須）</span></label>

        <div class="flex flex-wrap gap-2 min-h-8">
          <span x-show="selected" class="badge badge-primary gap-1 py-2 h-auto">
            <span x-text="selected ? selected.title + (selected.season ? '（' + selected.season + '）' : '') : ''"></span>
            <button type="button" @click="clear()" class="btn btn-ghost btn-xs p-0 min-h-0 h-auto leading-none">✕</button>
          </span>
          <span x-show="!selected" class="text-sm text-base-content/40">アニメ未選択</span>
        </div>

        <input type="text" class="input input-bordered w-full mt-2"
          placeholder="アニメ名で検索して選択..."
          x-model="query"
          @input="search()"
          autocomplete="off">
        <input type="hidden" name="artist[anime_id]" :value="selected ? selected.id : ''">

        <div x-show="results.length > 0" x-cloak
          class="absolute top-full left-0 right-0 z-10 mt-1 bg-base-100 border border-base-300 rounded-lg shadow-lg max-h-60 overflow-y-auto">
          <template x-for="anime in results" :key="anime.id">
            <div @click="choose(anime)"
              class="px-4 py-2 cursor-pointer hover:bg-base-200 text-sm"
              x-text="anime.title + (anime.season ? '（' + anime.season + '）' : '')">
            </div>
          </template>
        </div>
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">画像 URL</span></label>
        <%= f.text_field :image_url, class: "input input-bordered w-full", placeholder: "https://..." %>
      </div>
    </div>
  </div>

  <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>

  <div class="flex justify-end gap-2">
    <%= link_to "キャンセル", return_to_list_path(admin_artists_path), class: "btn btn-ghost" %>
    <%= f.submit (artist.persisted? ? "更新" : "登録"), class: "btn btn-primary" %>
  </div>
<% end %>

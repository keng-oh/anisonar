# Rails
RAILS_ENV=development
RAILS_MASTER_KEY=
APP_HOST=localhost

# Database / Redis
# DB_HOST=db       # 省略時 "db"（docker composeのサービス名）
# DB_PORT=5432     # 省略時 5432
DB_PASSWORD=password
REDIS_URL=redis://redis:6379/0

# Annict API
# https://annict.com/settings/apps
ANNICT_API_TOKEN=

# Spotify API
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Anthropic API（AI楽曲収集）
ANTHROPIC_API_KEY=

# Firecrawl（セルフホスト）
# https://github.com/mendableai/firecrawl
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=

# n8n連携API（クロール/抽出キュー）
N8N_API_TOKEN=

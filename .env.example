# Rails
RAILS_ENV=development
RAILS_MASTER_KEY=
APP_HOST=localhost

# Database / Redis
# DB_HOST=db       # 省略時 "db"（docker composeのサービス名）
# DB_PORT=5432     # 省略時 5432
DB_PASSWORD=password
REDIS_URL=redis://redis:6379/0

# Annict API
# https://annict.com/settings/apps
ANNICT_API_TOKEN=

# Spotify API
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Anthropic API（AI楽曲収集）
ANTHROPIC_API_KEY=

# Firecrawl（セルフホスト）
# https://github.com/mendableai/firecrawl
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=

# n8n連携API（クロール/抽出キュー）
N8N_API_TOKEN=

# Tailscale経由でDNS名を使ってローカルRailsへアクセスする場合の追加許可ホスト（カンマ区切り・完全一致）
# MagicDNSの *.ts.net はdevelopment設定で許可済みなので、それ以外の名前を使うときのみ設定する
# ANISONAR_DEV_HOSTS=anisonar.example.internal

# エラー・ジョブ失敗通知（任意・未設定なら送信スキップ）
# NTFY_URL=https://ntfy.example.com/anisonar-alerts
# NTFY_USERNAME=                 # Basic認証が必要な場合のみ
# NTFY_PASSWORD=
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# メール送信（Resend）
# https://resend.com/api-keys
RESEND_API_KEY=
MAILER_FROM="Anisonar <noreply@example.com>"
MAILER_REPLY_TO=contact@example.com
